<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.disscheng.weblog.mapper.TagMapper">
    <!-- 目录分页查询 -->
    <select id="pageQuery" resultType="com.disscheng.weblog.entity.Tag">
        SELECT id, name, create_time,update_time,  is_deleted FROM t_tag
        <where>
            <if test="name!= null">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="startDate != null">
                AND create_time >= #{startDate}
            </if>
            <if test="endDate != null">
                AND #{endDate} >= create_time
            </if>

        </where>
        ORDER BY id DESC
    </select>

</mapper>